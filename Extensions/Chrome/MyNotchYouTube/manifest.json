{
  "manifest_version": 3,
  "name": "MyNotch YouTube Bridge",
  "version": "0.1.2",
  "description": "Forwards the captions YouTube already loaded in Chrome to the MyNotch app on this Mac. Nothing goes over the network.",
  "minimum_chrome_version": "111",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "scripting"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "captions-page.js",
        "page.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "captions.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
